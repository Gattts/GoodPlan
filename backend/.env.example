# Copie para backend/.env e ajuste. O .env nunca vai para o git.
#
# Banco. Sem esta linha, o padrão é um SQLite em backend/data/goodplan.db.
# Postgres local (docker run ... ou docker compose up -d, porta 5433):
# GP_DATABASE_URL=postgresql://goodplan:goodplan-local@127.0.0.1:5433/goodplan
#
# Produção (Render): a API só atende o Worker e a rota das rotinas exige token.
# Gere os segredos com: openssl rand -hex 32 (pelo menos 32 caracteres).
# GP_PROXY_ONLY=true
# GP_PROXY_SECRET=
# GP_JOBS_TOKEN=
#
# Fontes (os padrões já apontam para os endereços públicos):
# GP_FRANKFURTER_URL=https://api.frankfurter.dev
# GP_OURAIRPORTS_URL=https://davidmegginson.github.io/ourairports-data/airports.csv
